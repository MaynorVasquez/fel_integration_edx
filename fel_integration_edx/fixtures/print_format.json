  "html": "<style>\n/* Contenedor principal del ticket */\n.print-format {\n    width: 58mm; /* ancho real de la impresora térmica */\n    padding: 1mm;\n    font-size: 6pt;\n    font-family: monospace; /* ideal para tickets */\n    line-height: 1.2;\n    word-break: break-word;\n    /* alto dinámico */\n    height: auto !important;\n}\n\n/* Filas flex para detalle de items */\n.row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin: 1px 0;\n}\n\n.col-desc { width: 25%; word-wrap: break-word; }\n.col-qty  { width: 10%; text-align: right; }\n.col-uom  { width: 25%; text-align: right; }\n.col-rate { width: 20%; text-align: right; }\n.col-total{ width: 20%; text-align: right; }\n\n.text-center { text-align: center; }\n.text-right  { text-align: right; }\n\nhr { border: 0; border-top: 1px dashed #000; margin: 4px 0; }\n\n/* Evita márgenes extra al imprimir */\n@media print {\n    body {\n        margin: 0;\n        padding: 0;\n    }\n    .print-format {\n        margin: 0;\n        height: auto !important; /* alto dinámico en impresión */\n    }\n}\n</style>\n\n<!-- Encabezado -->\n<div class=\"print-format\">\n    <p class=\"text-center\">\n        <b>Datos del emisor</b><br>\n        <b>{{ frappe.db.get_value(\"FEL Integration\", None, \"razon_social\") or \"\" }}</b><br>\n        <b>Nit: {{ frappe.db.get_value(\"FEL Integration\", None, \"nit_emisor\") or \"\" }}</b><br>\n        <b>Establecimiento: {{ doc.custom_establecimiento or \"\" }}</b><br>\n        <b>Dirección: {{ doc.custom_direccion_establecimiento or \"\" }}</b><br>\n    </p>\n\n    <p class=\"text-center\">\n        <b>Documento tributario electrónico</b><br>\n    </p>\n    <p>\n        <b>UUID:</b> {{ doc.custom_uuid or \"\" }}<br>\n        <b>Serie:</b> {{ doc.custom_serie or \"\" }}\n        <b>Número:</b> {{ doc.custom_numero or \"\" }}<br>\n        <b>Fecha:</b> {{ doc.custom_fecha or doc.get_formatted(\"posting_date\") }}<br>\n    </p>\n    \n    <p class=\"text-center\">\n        <b>Datos del receptor</b><br>\n    </p>\n    <p>\n        <b>Cliente:</b> {{ doc.customer_name }}<br>\n        <b>NIT:</b> {{ frappe.db.get_value(\"Customer\", doc.customer, \"custom_nit\") or \"\" }}<br>\n        <b>Dirección:</b> {{ doc.address_display or \"\" }}\n    </p>\n\n    <hr>\n\n    <!-- Encabezado de columnas -->\n    <div class=\"row\">\n        <div class=\"col-desc\"><b>Desc</b></div>\n        <div class=\"col-qty\"><b>Qty</b></div>\n        <div class=\"col-uom\"><b>UOM</b></div>\n        <div class=\"col-rate\"><b>Precio</b></div>\n        <div class=\"col-total\"><b>Total</b></div>\n    </div>\n\n    <!-- Items -->\n    {%- for item in doc.items -%}\n    <div class=\"row\">\n        <div class=\"col-desc\">{{ item.item_name }}</div>\n        <div class=\"col-qty\">{{ item.qty }}</div>\n        <div class=\"col-uom\">{{ item.uom }}</div>\n        <div class=\"col-rate\">{{ \"{:.2f}\".format(item.rate) }}</div>\n        <div class=\"col-total\">{{ \"{:.2f}\".format(item.amount) }}</div>\n    </div>\n    {%- endfor -%}\n\n    <hr>\n\n    <!-- Totales -->\n    <div class=\"row\">\n        <div style=\"width:70%; text-align:right\"><b>Total</b></div>\n        <div style=\"width:30%; text-align:right\">\n            <b>{{ \"{:.2f}\".format(doc.grand_total) }}</b>\n        </div>\n    </div>\n    \n    <hr>\n    <!-- Pie de página -->\n    <p class=\"text-center\">\n        <b>Datos del certificador</b><br>\n        {{ frappe.db.get_value(\"FEL Integration\", None, \"certificador\") or \"\" }}<br>\n        NIT: {{ frappe.db.get_value(\"FEL Integration\", None, \"nit_certificador\") or \"\" }}<br>\n    </p>\n    <hr>\n    <p class=\"text-center\">\n        <b>Datos adicionales</b><br>\n        Sujeto a pagos trimestrales ISR <br>\n        Agente de retención de IVA\n    </p>\n</div>\n",
